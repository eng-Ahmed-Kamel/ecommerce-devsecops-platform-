pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io/oziii'

        BACKEND_IMAGE = 'ecommerce-backend'
        FRONTEND_IMAGE = 'ecommerce-frontend'

        K8S_NAMESPACE = 'ecommerce'
        HELM_RELEASE = 'ecommerce'

        DOCKER_CREDENTIALS = 'docker-hub-credentials'
        KUBECONFIG_CREDENTIALS = 'kubeconfig'

        HELM_CHART = './helm-charts/ecommerce'
    }


    stages {

        stage('Security Scan - Dependencies') {
            parallel {

                stage('Backend Audit') {
                    steps {
                        dir('microservices/backend') {
                            sh '''
                            npm ci
                            npm audit --audit-level=high || true
                            '''
                        }
                    }
                }


                stage('Frontend Audit') {
                    steps {
                        dir('microservices/frontend') {
                            sh '''
                            npm ci
                            npm audit --audit-level=high || true
                            '''
                        }
                    }
                }
            }
        }



        stage('Build Docker Images') {

            parallel {

                stage('Backend') {
                    steps {
                        dir('microservices/backend') {

                            sh '''
                            docker build \
                            -f docker/Dockerfile \
                            -t ${DOCKER_REGISTRY}/${BACKEND_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_REGISTRY}/${BACKEND_IMAGE}:latest .
                            '''
                        }
                    }
                }



                stage('Frontend') {

                    steps {

                        dir('microservices/frontend') {

                            sh '''
                            docker build \
                            -t ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:latest .
                            '''
                        }
                    }
                }
            }
        }




        stage('Trivy Image Scan') {

            steps {

                sh '''

                trivy image \
                --severity HIGH,CRITICAL \
                --exit-code 0 \
                ${DOCKER_REGISTRY}/${BACKEND_IMAGE}:${BUILD_NUMBER}


                trivy image \
                --severity HIGH,CRITICAL \
                --exit-code 0 \
                ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${BUILD_NUMBER}

                '''
            }
        }




        stage('Push Docker Images') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {


                    sh '''

                    echo "$DOCKER_PASS" | docker login \
                    -u "$DOCKER_USER" \
                    --password-stdin


                    docker push ${DOCKER_REGISTRY}/${BACKEND_IMAGE}:${BUILD_NUMBER}
                    docker push ${DOCKER_REGISTRY}/${BACKEND_IMAGE}:latest


                    docker push ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${BUILD_NUMBER}
                    docker push ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:latest


                    '''
                }
            }
        }





        stage('Deploy With Helm') {

            steps {

                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CREDENTIALS}",
                        variable: 'KUBECONFIG'
                    )
                ]) {


                    sh '''

                    export KUBECONFIG=$KUBECONFIG


                    helm upgrade --install ${HELM_RELEASE} ${HELM_CHART} \
                    --namespace ${K8S_NAMESPACE} \
                    --create-namespace \
                    --set backend.image.repository=${DOCKER_REGISTRY}/${BACKEND_IMAGE} \
                    --set backend.image.tag=${BUILD_NUMBER} \
                    --set frontend.image.repository=${DOCKER_REGISTRY}/${FRONTEND_IMAGE} \
                    --set frontend.image.tag=${BUILD_NUMBER} \
                    --wait \
                    --timeout 5m


                    '''
                }
            }
        }





        stage('Verify Deployment') {

            steps {

                sh '''

                kubectl get pods -n ${K8S_NAMESPACE}

                kubectl rollout status \
                deployment/backend \
                -n ${K8S_NAMESPACE}


                kubectl rollout status \
                deployment/frontend \
                -n ${K8S_NAMESPACE}


                '''
            }
        }

    }



    post {

        always {

            sh '''
            docker logout || true
            docker system prune -f || true
            '''

            cleanWs()
        }


        success {

            echo "✅ Deployment successful Build #${BUILD_NUMBER}"

        }


        failure {

            echo "❌ Deployment failed"

            sh '''
            helm history ${HELM_RELEASE} -n ${K8S_NAMESPACE} || true
            '''
        }
    }
}
